{
  "name": "@scrapeer/mcp-server",
  "version": "0.1.1",
  "description": "Run Scrapeer visual web-scraping flows from AI agents",
  "mcpName": "com.scrapeer/mcp-server",
  "type": "module",
  "bin": {
    "scrapeer-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:release": "node scripts/verify-release-metadata.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Scrapeer/scrapeer-mcp-server.git"
  },
  "homepage": "https://www.scrapeer.com",
  "bugs": {
    "url": "https://github.com/Scrapeer/scrapeer-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "scrapeer",
    "scraping",
    "web-scraping",
    "browser-automation",
    "automation",
    "ai-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "msw": "^2.7.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
